# 复制为 .env 后填入真实值：
#   copy .env.example .env
# DeepSeek 控制台申请的 key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 短期 checkpoint 和长期记忆。先在本目录执行 docker compose up -d
MEMORY_DATABASE_URL=postgresql://study:study@127.0.0.1:5432/study
# 长期记忆的嵌入模型。DeepSeek 没有 embeddings 接口。
# 默认本机中文模型。有 OpenAI key 时可以改成 openai:text-embedding-3-small
EMBEDDING_MODEL=huggingface:BAAI/bge-small-zh-v1.5
# 可选：固定 Hugging Face 模型的 revision；改变后需要显式迁移索引。
# EMBEDDING_REVISION=
# 默认使用官方 ag-ui-langgraph；legacy 可临时回退原有同步事件适配。
AGUI_ADAPTER=langgraph
# 以下均为总尝试次数（包含首次），不能超过 10；写工具不做故障重试。
MODEL_MAX_ATTEMPTS=3
MCP_READ_MAX_ATTEMPTS=3
TOOL_READ_MAX_ATTEMPTS=3
MCP_CONNECT_MAX_ATTEMPTS=3
# 指数退避带抖动；优先遵守服务器 Retry-After，并受运行剩余期限限制。
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=5
RETRY_ATTEMPT_TIMEOUT=15
MODEL_ATTEMPT_TIMEOUT=60
